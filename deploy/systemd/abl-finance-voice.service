[Unit]
Description=ABL daily spending summary (abl1) -> data/abl/finance/latest.json
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/abl/odysseus
EnvironmentFile=-%h/.config/abl/abl1.env
ExecStart=%h/abl/odysseus/venv/bin/python -m src.finance_voice_abl1
Nice=10
MemoryMax=300M
TimeoutStartSec=120
