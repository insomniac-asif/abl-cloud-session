# ~/.config/abl/abl1.env  (chmod 600) — read by the briefing + finance units.
# Mail source: EITHER a Maildir/.eml directory ...
ABL_MAIL_DIR=/home/rescue/Mail/INBOX
# ... OR read-only IMAP (the password lives in its own 0600 file, never in this env file):
#ABL_IMAP_HOST=imap.gmail.com
#ABL_IMAP_USER=you@example.com
#ABL_IMAP_PASSWORD_FILE=/home/rescue/.config/abl/imap.pass
# Weather: home location, rounded to 0.1 degrees before any request leaves the box.
ABL_HOME_LAT=40.76
ABL_HOME_LON=-73.99
#ABL_UNITS=celsius
# Calendar: ICS file or a LOCAL/tailnet URL (remote URLs are refused).
#ABL_CALENDAR_ICS=/home/rescue/abl/data/calendar.ics
# Optional bills ledger: [{"payee":"Rent","due":"2026-12-01","amount":2100,"autopay":true}]
#ABL_BILLS_FILE=/home/rescue/abl/data/bills.json
# Known contacts (comma-separated emails/numbers) for the "people" category.
#ABL_AUTORESPONDER_CONTACTS=mom@example.com,+15551234567
#ABL_LARGE_AMOUNT=500
