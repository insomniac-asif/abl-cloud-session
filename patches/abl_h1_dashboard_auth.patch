diff --git a/tests/test_v016_h1_dashboard_auth.py b/tests/test_v016_h1_dashboard_auth.py
new file mode 100644
index 0000000..83bc52b
--- /dev/null
+++ b/tests/test_v016_h1_dashboard_auth.py
@@ -0,0 +1,119 @@
+"""SECURITY_SCAN H1 — the dashboard must never serve agent chat or accept operator input
+unauthenticated, and production must always wire DashboardAuth + a loopback bind.
+
+Behaviour tests use create_app(..., auth=DashboardAuth(_token_override=...)).
+Wiring tests are AST invariants on orchestrator.py (PATTERNS #68: AST, not substrings),
+so deleting the auth= kwarg or reintroducing a literal "0.0.0.0" bind fails on the diff.
+"""
+from __future__ import annotations
+
+import ast
+import inspect
+import textwrap
+from unittest.mock import MagicMock
+
+import pytest
+from fastapi.testclient import TestClient
+
+from abl.web.app import create_app
+from abl.web.auth import DashboardAuth
+
+TOKEN = "t" * 32
+
+
+def _app(**kw):
+    bus = MagicMock()
+    bus.subscribe = MagicMock(side_effect=lambda *a, **k: _EmptySub())
+    return create_app(bus, hmac_secret="test-secret", auth=DashboardAuth(_token_override=TOKEN), **kw)
+
+
+class _EmptySub:
+    def __aiter__(self):
+        return self
+
+    async def __anext__(self):
+        raise StopAsyncIteration
+
+    def close(self):
+        pass
+
+
+@pytest.fixture
+def client():
+    with TestClient(_app()) as c:
+        yield c
+
+
+@pytest.mark.parametrize("method,path", [
+    ("GET", "/chat/history"), ("POST", "/chat/send"), ("GET", "/proposals"),
+    ("POST", "/proposals/00000000-0000-0000-0000-000000000000/approve"),
+    ("POST", "/proposals/00000000-0000-0000-0000-000000000000/reject"), ("GET", "/agents/status"),
+])
+def test_unauthenticated_requests_are_refused(client, method, path):
+    r = client.request(method, path, json={"content": "hi"})
+    assert r.status_code == 401
+
+
+def test_browser_gets_redirected_to_login(client):
+    r = client.get("/", headers={"accept": "text/html"}, follow_redirects=False)
+    assert r.status_code == 303 and r.headers["location"] == "/login"
+    assert "Dashboard token" in client.get("/login").text
+
+
+def test_health_stays_public(client):
+    assert client.get("/system/health").status_code != 401
+
+
+def test_wrong_token_rejected(client):
+    assert client.post("/auth/login", json={"token": "nope"}).status_code == 401
+    assert client.get("/chat/history", headers={"authorization": "Bearer nope"}).status_code == 401
+
+
+def test_login_sets_strict_httponly_cookie_and_unlocks(client):
+    r = client.post("/auth/login", data={"token": TOKEN}, follow_redirects=False)
+    assert r.status_code == 303
+    cookie = r.headers["set-cookie"].lower()
+    assert "abl_dash_session=" in cookie and "httponly" in cookie and "samesite=strict" in cookie
+    assert client.get("/chat/history").status_code == 200
+
+
+def test_bearer_token_for_scripts(client):
+    assert client.get("/chat/history", headers={"authorization": f"Bearer {TOKEN}"}).status_code == 200
+
+
+def test_websocket_refused_without_auth(client):
+    from starlette.websockets import WebSocketDisconnect
+    with pytest.raises(WebSocketDisconnect) as e:
+        with client.websocket_connect("/chat/stream") as ws:
+            ws.receive_json()
+    assert e.value.code == 4401
+
+
+def test_chat_send_pins_operator_role_server_side():
+    src = inspect.getsource(create_app)
+    tree = ast.parse(textwrap.dedent(src))
+    send = next(n for n in ast.walk(tree) if isinstance(n, ast.AsyncFunctionDef) and n.name == "send_message")
+    kws = {k.arg: k.value for n in ast.walk(send) if isinstance(n, ast.Call) for k in n.keywords}
+    assert isinstance(kws["user_role"], ast.Constant) and kws["user_role"].value == "operator"
+    assert isinstance(kws["user_id"], ast.Constant)        # never getattr(msg, ...) from the request body
+
+
+def _orchestrator_tree():
+    # Parse, don't import: importing pulls chromadb and the whole runtime.
+    from pathlib import Path
+    import abl
+    return ast.parse((Path(abl.__file__).parent / "orchestrator.py").read_text(encoding="utf-8"))
+
+
+def test_orchestrator_always_passes_auth_to_create_app():
+    calls = [n for n in ast.walk(_orchestrator_tree())
+             if isinstance(n, ast.Call) and getattr(n.func, "id", getattr(n.func, "attr", "")) == "create_app"]
+    assert calls, "orchestrator no longer calls create_app?"
+    for c in calls:
+        assert any(k.arg == "auth" for k in c.keywords), "create_app called without auth= (H1 regression)"
+
+
+def test_orchestrator_never_binds_literal_all_interfaces():
+    for n in ast.walk(_orchestrator_tree()):
+        if isinstance(n, ast.Constant) and n.value == "0.0.0.0":
+            pytest.fail(f'literal "0.0.0.0" at orchestrator.py:{n.lineno} (bind via ABL_WEB_HOST, default 127.0.0.1)')
