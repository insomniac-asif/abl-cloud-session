@@ -157,6 +164,62 @@ def create_app(
 
     app = FastAPI(title="ABL Group Chat", version="0.2.0", lifespan=lifespan)
 
+    # --- Auth (SECURITY_SCAN H1): owner token / session cookie on every route ---
+    _PUBLIC = {("GET", "/system/health"), ("GET", "/login"), ("POST", "/auth/login")}
+    _COOKIE = "abl_dash_session"
+
+    def _authed(headers: Any, cookies: Any) -> bool:
+        if auth is None:
+            return True
+        bearer = (headers.get("authorization") or "").removeprefix("Bearer ").strip()
+        if bearer and auth.validate_token(bearer):
+            return True
+        sid = cookies.get(_COOKIE, "")
+        return bool(sid) and bool(auth.validate_session(sid))
+
+    if auth is not None:
+        # Request is imported at module level: with `from __future__ import annotations`
+        # a locally-imported annotation can't be resolved and FastAPI would 422 the login.
+        from fastapi.responses import HTMLResponse as _LoginHTML, RedirectResponse
+
+        @app.middleware("http")
+        async def _require_owner(request: Request, call_next):
+            if (request.method, request.url.path) in _PUBLIC or _authed(request.headers, request.cookies):
+                return await call_next(request)
+            if request.method == "GET" and "text/html" in (request.headers.get("accept") or ""):
+                return RedirectResponse("/login", status_code=303)
+            return JSONResponse({"detail": "dashboard token required"}, status_code=401)
+
+        @app.get("/login")
+        async def login_page():
+            return _LoginHTML(
+                "<!doctype html><meta name=viewport content='width=device-width'>"
+                "<title>ABL login</title><body style='background:#161b30;color:#fff;font:16px system-ui;padding:24px'>"
+                "<form method=post action=/auth/login><p>Dashboard token (~/.abl/dashboard_token)</p>"
+                "<input name=token type=password autofocus style='width:100%;max-width:420px;padding:8px'>"
+                "<button style='margin-top:12px;padding:8px 16px;background:#cbbbff;border:0'>Sign in</button></form>")
+
+        @app.post("/auth/login")
+        async def login(request: Request):
+            token = ""
+            if "application/json" in (request.headers.get("content-type") or ""):
+                try:
+                    token = str((await request.json()).get("token", ""))
+                except Exception:
+                    token = ""
+            else:
+                form = (await request.body()).decode("utf-8", "replace")
+                from urllib.parse import parse_qs
+                token = (parse_qs(form).get("token") or [""])[0]
+            sid = auth.validate_token(token.strip()) if token else None
+            if not sid:
+                return JSONResponse({"detail": "invalid token"}, status_code=401)
+            resp = RedirectResponse("/", status_code=303)
+            resp.set_cookie(_COOKIE, sid, httponly=True, samesite="strict", path="/")
+            return resp
+    else:
+        logger.warning("create_app(auth=None): dashboard routes are UNAUTHENTICATED (tests only)")
+
     # --- Static files ---
     if _STATIC_DIR.is_dir():
         app.mount("/static", StaticFiles(directory=str(_STATIC_DIR)), name="static")
@@ -220,14 +283,17 @@ def create_app(
         adapter = AgentBusAdapter(bus, AgentID.HUMAN, hmac_secret)
         payload = UserInputPayload(
             text=msg.content,
-            user_id=getattr(msg, "user_id", "asif"),
-            user_role=getattr(msg, "user_role", "operator"),
+            user_id="asif",            # authenticated owner; never taken from the request body
+            user_role="operator",
         )
         envelope = await adapter.broadcast(payload)
         return {"status": "sent", "message_id": str(envelope.id)}
 
     @app.websocket("/chat/stream")
